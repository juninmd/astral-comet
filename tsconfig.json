{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "types": [
      "chrome"
    ]
  },
  "include": [
    "src/**/*"
  ]
}
